FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install core compiler, build tools, debugging utilities, AND Git
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    gcc-arm-none-eabi \
    libnewlib-arm-none-eabi \
    openocd \
    gdb-multiarch \
    usbutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

ENTRYPOINT ["/bin/bash", "-c"]
